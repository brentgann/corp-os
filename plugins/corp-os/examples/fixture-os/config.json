{
  "corpos_version": "0.7.0",
  "profile": "custom",
  "vocabulary": {
    "claim": "finding",
    "confidence": [
      "confirmed",
      "needs_review",
      "reconstructed",
      "disputed",
      "retired"
    ],
    "sensitivity": [
      "internal",
      "sensitive"
    ],
    "tags": [
      "Platform",
      "Pricing",
      "Support"
    ]
  },
  "layers": {
    "raw": {
      "enabled": true,
      "role": "source",
      "path": "raw/"
    },
    "jobs": {
      "enabled": true,
      "role": "derived",
      "path": "jobs/",
      "index_line": "{id} — {statement}",
      "entry_schema": [
        "id",
        "statement",
        "kind",
        "status",
        "horizon",
        "readiness",
        "last_touched"
      ]
    },
    "claims": {
      "enabled": true,
      "role": "derived",
      "path": "claims/",
      "entry_schema": [
        "id",
        "statement",
        "kind",
        "jobs",
        "confidence",
        "source",
        "citation",
        "sensitivity",
        "bearing",
        "decay",
        "verified"
      ]
    },
    "glossary": {
      "enabled": false,
      "role": "derived"
    },
    "proposals": {
      "enabled": true,
      "role": "record",
      "path": "proposals/"
    },
    "decisions": {
      "enabled": true,
      "role": "derived",
      "gated": true,
      "path": "decisions/",
      "entry_schema": {
        "id": {
          "type": "string",
          "required": true
        },
        "statement": {
          "type": "string",
          "required": true
        },
        "owner": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "enum",
          "values": [
            "open",
            "blocked",
            "decided",
            "lapsed",
            "moot"
          ]
        },
        "decide_by": {
          "type": "date",
          "required": true
        },
        "reversibility": {
          "type": "enum",
          "values": [
            "reversible",
            "costly",
            "one-way"
          ]
        },
        "blocks": {
          "type": "list"
        }
      },
      "index_line": "{id} — {statement} · {owner} · by {decide_by}",
      "decay": "none"
    },
    "dashboards": {
      "enabled": true,
      "role": "record",
      "path": "dashboards.md"
    },
    "sensitive": {
      "enabled": true,
      "role": "record",
      "path": "sensitive.md",
      "in_scan_path": false,
      "entry_marker": "### ",
      "note": "quarantine for incidental sensitive material; declared as a layer so a rebuild knows it exists"
    },
    "patterns": {
      "enabled": true,
      "role": "record",
      "path": "patterns/",
      "entry_schema": [
        "name",
        "kind",
        "pack",
        "requires",
        "target",
        "shield",
        "generator"
      ],
      "index_line": "{name} — {kind} · {target}",
      "note": "adopted output specs; portable because they address layers by role and field"
    },
    "arguments": {
      "enabled": true,
      "role": "derived",
      "path": "arguments/",
      "entry_schema": [
        "id",
        "so_what",
        "timing",
        "status",
        "rests_on",
        "confidence",
        "sensitivity"
      ],
      "index_line": "{id} — {so_what} · {status}",
      "order_by": "status",
      "note": "conclusions across findings; rare on purpose, and the only layer here with a working removal rule"
    },
    "connectors": {
      "enabled": true,
      "role": "record",
      "path": "connectors.md",
      "entry_marker": "### ",
      "note": "declared so a rebuild knows it exists"
    }
  },
  "decay": {
    "enabled": true,
    "default": "90d",
    "applies_to": "sourced",
    "by_kind": {
      "decision": "none",
      "metric": "30d"
    }
  },
  "retention": {
    "raw": {
      "policy": "keep",
      "measure_from": "frontmatter_date"
    }
  },
  "gate": {
    "mode": "propose"
  },
  "scan": {
    "excluded_from_scan": [
      "usage/",
      "sensitive.md"
    ]
  }
}
